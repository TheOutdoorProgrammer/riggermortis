{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "Catalog": {
            "enum": [
                "abok",
                "wikidata",
                "gbif",
                "itis",
                "worms",
                "fao-isscfg",
                "agrovoc"
            ]
        },
        "Common": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "external_ids": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ExternalId"
                    }
                },
                "former_ids": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Id"
                    }
                },
                "id": {
                    "$ref": "#/$defs/Id"
                },
                "schema_version": {
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                },
                "validation": {
                    "$ref": "#/$defs/Validation"
                }
            },
            "required": [
                "id",
                "schema_version",
                "validation"
            ]
        },
        "CopyPolicy": {
            "enum": [
                "cite-only",
                "quotable",
                "adaptable"
            ]
        },
        "ExternalId": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "catalog": {
                    "$ref": "#/$defs/Catalog"
                },
                "id": {
                    "type": "string",
                    "description": "Always a string. Catalogue identifiers carry prefixes, leading zeros\nand whole URIs, so a number would silently corrupt them."
                },
                "rank": {
                    "$ref": "#/$defs/Rank"
                },
                "source": {
                    "$ref": "#/$defs/Id"
                }
            },
            "required": [
                "catalog",
                "id"
            ]
        },
        "Id": {
            "type": "string",
            "description": "Exactly one dot. Category from #IdCategory, name in lowercase kebab-case.",
            "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "Rank": {
            "enum": [
                "preferred",
                "normal",
                "deprecated"
            ]
        },
        "Reliability": {
            "enum": [
                "low",
                "medium",
                "high"
            ]
        },
        "SourceType": {
            "enum": [
                "book",
                "article",
                "agency",
                "extension",
                "manufacturer",
                "video",
                "expert",
                "forum"
            ]
        },
        "Validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "events": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ValidationEvent"
                    }
                },
                "status": {
                    "$ref": "#/$defs/ValidationStatus"
                }
            },
            "required": [
                "status"
            ]
        },
        "ValidationEvent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "by": {
                    "type": "string"
                },
                "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "detail": {
                    "type": "string"
                },
                "method": {
                    "$ref": "#/$defs/ValidationMethod"
                },
                "result": {
                    "$ref": "#/$defs/ValidationResult"
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Id"
                    }
                }
            },
            "required": [
                "by",
                "date",
                "method",
                "result"
            ]
        },
        "ValidationMethod": {
            "enum": [
                "ci",
                "source-corroborated",
                "manufacturer-confirmed",
                "photo-compared",
                "tied",
                "fished",
                "expert-review"
            ]
        },
        "ValidationResult": {
            "enum": [
                "pass",
                "fail",
                "partial",
                "disputed"
            ]
        },
        "ValidationStatus": {
            "enum": [
                "unvalidated",
                "machine-only",
                "corroborated",
                "field-tested",
                "disputed"
            ]
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "accessed": {
            "type": "string"
        },
        "author": {
            "type": "string"
        },
        "copy_policy": {
            "$ref": "#/$defs/CopyPolicy"
        },
        "kind": {
            "const": "source"
        },
        "license": {
            "type": "string",
            "description": "SPDX identifier, or the literals below. Not an enum: SPDX is the registry."
        },
        "notes": {
            "type": "string"
        },
        "reliability": {
            "$ref": "#/$defs/Reliability"
        },
        "title": {
            "type": "string"
        },
        "type": {
            "$ref": "#/$defs/SourceType"
        },
        "url": {
            "type": "string"
        },
        "year": {
            "anyOf": [
                {
                    "type": "integer"
                },
                {
                    "type": "null"
                }
            ]
        }
    },
    "$ref": "#/$defs/Common",
    "required": [
        "copy_policy",
        "license",
        "reliability",
        "title",
        "type",
        "year"
    ]
}
