{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "BendStyle": {
            "enum": [
                "round",
                "octopus",
                "circle",
                "worm",
                "ewg",
                "offset-worm",
                "straight-shank",
                "kahle",
                "aberdeen",
                "siwash",
                "treble"
            ]
        },
        "BodyProfile": {
            "enum": [
                "straight",
                "curly-tail",
                "paddle-tail",
                "creature",
                "craw",
                "fluke",
                "tube",
                "grub",
                "worm-live",
                "baitfish",
                "cut"
            ]
        },
        "Catalog": {
            "enum": [
                "abok",
                "wikidata",
                "gbif",
                "itis",
                "worms",
                "fao-isscfg",
                "agrovoc"
            ]
        },
        "Common": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "external_ids": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ExternalId"
                    }
                },
                "former_ids": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Id"
                    }
                },
                "id": {
                    "$ref": "#/$defs/Id"
                },
                "schema_version": {
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                },
                "validation": {
                    "$ref": "#/$defs/Validation"
                }
            },
            "required": [
                "id",
                "schema_version",
                "validation"
            ]
        },
        "ExternalId": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "catalog": {
                    "$ref": "#/$defs/Catalog"
                },
                "id": {
                    "type": "string",
                    "description": "Always a string. Catalogue identifiers carry prefixes, leading zeros\nand whole URIs, so a number would silently corrupt them."
                },
                "rank": {
                    "$ref": "#/$defs/Rank"
                },
                "source": {
                    "$ref": "#/$defs/Id"
                }
            },
            "required": [
                "catalog",
                "id"
            ]
        },
        "Id": {
            "type": "string",
            "description": "Exactly one dot. Category from #IdCategory, name in lowercase kebab-case.",
            "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "Mounting": {
            "enum": [
                "tied",
                "threaded",
                "rigged"
            ]
        },
        "Pin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/$defs/PinType"
                },
                "wire_diameter_mm": {
                    "type": "number"
                }
            },
            "required": [
                "id",
                "type"
            ]
        },
        "PinType": {
            "enum": [
                "closed-eye",
                "open-eye",
                "split-ring",
                "shank",
                "snap",
                "arm-socket",
                "line-end",
                "in",
                "out",
                "loop",
                "tag"
            ]
        },
        "PointStyle": {
            "enum": [
                "straight",
                "turned-in",
                "turned-out",
                "knife-edge",
                "needle"
            ]
        },
        "Rank": {
            "enum": [
                "preferred",
                "normal",
                "deprecated"
            ]
        },
        "Shank": {
            "enum": [
                "short",
                "standard",
                "long",
                "extra-long"
            ]
        },
        "Validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "events": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ValidationEvent"
                    }
                },
                "status": {
                    "$ref": "#/$defs/ValidationStatus"
                }
            },
            "required": [
                "status"
            ]
        },
        "ValidationEvent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "by": {
                    "type": "string"
                },
                "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "detail": {
                    "type": "string"
                },
                "method": {
                    "$ref": "#/$defs/ValidationMethod"
                },
                "result": {
                    "$ref": "#/$defs/ValidationResult"
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Id"
                    }
                }
            },
            "required": [
                "by",
                "date",
                "method",
                "result"
            ]
        },
        "ValidationMethod": {
            "enum": [
                "ci",
                "source-corroborated",
                "manufacturer-confirmed",
                "photo-compared",
                "tied",
                "fished",
                "expert-review"
            ]
        },
        "ValidationResult": {
            "enum": [
                "pass",
                "fail",
                "partial",
                "disputed"
            ]
        },
        "ValidationStatus": {
            "enum": [
                "unvalidated",
                "machine-only",
                "corroborated",
                "field-tested",
                "disputed"
            ]
        },
        "VariantAxis": {
            "enum": [
                "mass_g",
                "gap_mm",
                "diameter_mm",
                "rating_kg",
                "breaking_load_kg",
                "length_mm",
                "supports_g"
            ]
        },
        "Variants": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "axis": {
                    "$ref": "#/$defs/VariantAxis"
                },
                "values": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                }
            },
            "required": [
                "axis"
            ]
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "bend_style": {
            "$ref": "#/$defs/BendStyle"
        },
        "blocks_passage": {
            "type": "boolean"
        },
        "body_profile": {
            "$ref": "#/$defs/BodyProfile"
        },
        "bore_mm": {
            "type": "number",
            "description": "Validator-only. Never rendered."
        },
        "kind": {
            "const": "component"
        },
        "landmarks": {
            "type": "object",
            "additionalProperties": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
            }
        },
        "mounting": {
            "$ref": "#/$defs/Mounting"
        },
        "name": {
            "type": "string"
        },
        "pins": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/Pin"
            }
        },
        "point_style": {
            "$ref": "#/$defs/PointStyle"
        },
        "shank": {
            "$ref": "#/$defs/Shank"
        },
        "soft": {
            "type": "boolean"
        },
        "variants": {
            "$ref": "#/$defs/Variants"
        }
    },
    "$ref": "#/$defs/Common",
    "required": [
        "blocks_passage",
        "mounting",
        "name"
    ]
}
